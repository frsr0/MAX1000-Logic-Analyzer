# Line endings: store text as LF in the repository and let each checkout use
# its platform's endings. Before this file existed, editors and scripts on
# this Windows checkout left many files with mixed CRLF/LF lines, which turned
# small edits into whole-file diffs.
* text=auto

# Shell scripts run under bash (CI and Git Bash) and must stay LF.
*.sh text eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch their bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.sof binary
*.pof binary
*.jic binary
*.rbf binary
*.bin binary
*.npz binary
*.zip binary
*.xlsx binary
*.woff binary
*.woff2 binary
